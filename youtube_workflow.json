{
  "workflow_name": "youtube_lfd_transcript_extractor",
  "target_channels": ["@rsloncars", "@CCR-Galib"],
  "description": "LfD workflow derived from Playwright codegen recording",
  "steps": [
    {
      "step": 1,
      "action": "navigate_channel",
      "target_url_template": "https://www.youtube.com/{channel}/videos"
    },
    {
      "step": 2,
      "action": "click_first_video",
      "selector": "ytd-rich-item-renderer #video-title"
    },
    {
      "step": 3,
      "action": "expand_description",
      "selector": "button#expand, tp-yt-paper-button#expand"
    },
    {
      "step": 4,
      "action": "open_transcript",
      "selectors": [
        "button[aria-label*='Show transcript' i]",
        "button:has-text('Show transcript')"
      ]
    },
    {
      "step": 5,
      "action": "extract_segments",
      "container": "ytd-transcript-segment-renderer",
      "timestamp": ".segment-timestamp",
      "text": ".segment-text"
    }
  ]
}